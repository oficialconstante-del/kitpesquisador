<!DOCTYPE html>
<html lang="{{ site.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set tituloCompleto = (titulo + " | " + site.nome) if titulo else (site.nome + " — " + site.slogan) %}
  <title>{{ tituloCompleto }}</title>
  <meta name="description" content="{{ descricao or site.slogan }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ tituloCompleto }}">
  <meta property="og:description" content="{{ descricao or site.slogan }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="pt_BR">
  <meta property="og:site_name" content="{{ site.nome }}">
  <meta property="og:image" content="{{ site.url }}/og-image.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#0f2548">
  <link rel="icon" href="/favicon.ico" sizes="48x48">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  {% if semindexar %}<meta name="robots" content="noindex">{% endif %}
  <script>
    try {
      var tema = localStorage.getItem("kp_tema");
      if (!tema && window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches) tema = "escuro";
      if (tema === "escuro") document.documentElement.setAttribute("data-tema", "escuro");
    } catch (e) {}
  </script>
  <link rel="stylesheet" href="/css/estilo.css?v={{ versao }}">
  {% if site.adsenseClient %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>
  {% endif %}
</head>
<body>
  <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
  {% include "cabecalho.njk" %}
  <main id="conteudo" class="recipiente conteudo">
    {{ content | safe }}
  </main>
  {% include "rodape.njk" %}
  <script src="/js/tema.js?v={{ versao }}" defer></script>
  {% if scripts %}
    {% for s in scripts %}<script src="/js/{{ s }}?v={{ versao }}" defer></script>
    {% endfor %}
  {% endif %}
</body>
</html>
