<!DOCTYPE html>
<html lang="{{ site.idioma }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set tituloCompleto = (titulo + " | " + site.nome) if titulo else (site.nome + " — " + site.slogan) %}
  <title>{{ tituloCompleto }}</title>
  <meta name="description" content="{{ descricao or site.slogan }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ tituloCompleto }}">
  <meta property="og:description" content="{{ descricao or site.slogan }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="pt_BR">
  {% if semindexar %}<meta name="robots" content="noindex">{% endif %}
  <link rel="stylesheet" href="/css/estilo.css">
  {% if site.adsenseClient %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ site.adsenseClient }}" crossorigin="anonymous"></script>
  {% endif %}
</head>
<body>
  <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
  {% include "cabecalho.njk" %}
  <main id="conteudo" class="recipiente conteudo">
    {{ content | safe }}
  </main>
  {% include "rodape.njk" %}
  {% if scripts %}
    {% for s in scripts %}<script src="/js/{{ s }}" defer></script>
    {% endfor %}
  {% endif %}
</body>
</html>
